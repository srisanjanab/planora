# Copy this file to .env and change the values
DATABASE_URL=postgresql+psycopg2://planora:planora_pass@localhost:5433/planora_db
# No Docker? Use SQLite instead: DATABASE_URL=sqlite:///./planora.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173
